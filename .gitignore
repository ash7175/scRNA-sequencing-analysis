
# .gitignore for R Single-Cell RNA-seq Project

# Data files 


# Raw data
data/raw/**/*.mtx
data/raw/**/*.mtx.gz
data/raw/**/*.h5
data/raw/**/*.h5ad
data/raw/**/*.loom
data/raw/**/*.rds
data/raw/**/*.tar.gz
data/raw/**/*.fastq
data/raw/**/*.fastq.gz
data/raw/**/*.bam
data/raw/**/*.sam
data/raw/**/*.tsv

# Processed data
data/processed/**/*.rds
data/processed/**/*.h5
data/processed/**/*.h5ad
data/processed/**/*.h5Seurat


data/metadata/**/*.rds
data/metadata/**/*.csv.gz


!data/raw/example/*.mtx.gz
!data/processed/example/*.rds

# Results - Selective tracking

# Large result files
results/**/*.rds
results/**/*.h5
results/**/*.RData

# Keep small tables and plots
!results/tables/*.csv
!results/tables/*.xlsx
!results/figures/*.png
!results/figures/*.pdf
!results/QC/*.pdf

# Temporary results
results/tmp/
results/temp/



